<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- Intentional .NET 10 compiler-host baseline; .NET Framework analyzer hosts are not supported. -->
    <NoWarn>$(NoWarn);RS2008;RS1041</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TinyBench.Core\TinyBench.Core.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

  <!-- ProjectReference consumers must give Roslyn the implementation dependency as well as the analyzer. -->
  <Target Name="AddCoreAnalyzerDependency" AfterTargets="GetTargetPathWithTargetPlatformMoniker">
    <ItemGroup>
      <TargetPathWithTargetPlatformMoniker Include="$(TargetDir)TinyBench.Core.dll" IncludeRuntimeDependency="false" />
    </ItemGroup>
  </Target>

</Project>
